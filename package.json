{
    "name": "budget-pro",
    "version": "0.0.1",
    "private": true,
    "description": "A private, local-first personal budget for your desktop",
    "keywords": [
        "quasar",
        "quasar-app",
        "quasar-app-vite",
        "quasar-cli",
        "vite",
        "vue",
        "vuejs"
    ],
    "author": "John Luscombe <jluscombe96@gmail.com>",
    "type": "module",
    "scripts": {
        "lint": "oxfmt && oxlint --fix",
        "lint:check": "oxfmt --check && oxlint",
        "dev": "quasar dev",
        "build": "quasar build",
        "typecheck": "vue-tsc --noEmit",
        "postinstall": "quasar prepare --silent",
        "dev:electron": "quasar dev -m electron",
        "build:electron": "quasar build -m electron",
        "build:electron:dir": "quasar build -m electron --skip-pkg",
        "test": "vitest run",
        "test:unit": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "npm run build:electron:dir && playwright test",
        "test:e2e:only": "playwright test"
    },
    "dependencies": {
        "@quasar/extras": "^2.1.0",
        "quasar": "^2.35.4",
        "vue": "^3.5.22",
        "vue-router": "^5.0.6"
    },
    "devDependencies": {
        "@electron/packager": "^20.3.0",
        "@playwright/test": "^1.65.1",
        "@quasar/app-vite": "^3.10.4",
        "@types/node": "^22.19.11",
        "@vitest/coverage-v8": "^5.1.0",
        "autoprefixer": "^10.4.27",
        "electron": "^45.3.2",
        "oxfmt": "^0.x",
        "oxlint": "^1.x",
        "oxlint-tsgolint": "^7.0.2001",
        "postcss": "^8.5.8",
        "typescript": "^6.0.0",
        "vitest": "^5.1.0",
        "vue-tsc": "^3.3.3"
    },
    "engines": {
        "node": ">= 26 || ^24 || ^22.12"
    },
    "productName": "Budget Pro"
}
